{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batteryscope.local/schemas/plugin-manifest.schema.json",
  "title": "BatteryScope plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["plugin_id", "name", "vendor", "version", "supported_devices", "capabilities", "minimum_app_version"],
  "properties": {
    "plugin_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "name": {"type": "string", "minLength": 1},
    "vendor": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "supported_devices": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "minimum_app_version": {"type": "string", "minLength": 1}
  }
}
